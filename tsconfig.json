{
  "compilerOptions": {
    "outDir": "./dist/",
    "sourceMap": true,
    "noImplicitAny": true,
    "module": "esnext",
    "moduleResolution": "node",
    "target": "es2018",
    "allowJs": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "importHelpers": true,
    "strict": true,
    "types": ["jest", "node"],
    "jsx": "react",
    "lib": ["dom", "dom.iterable", "es2018", "es2020.bigint", "esnext.collection", "esnext.disposable"]
  },
  "include": [
    "./src/**/*"
  ]
}
