{
  "compilerOptions": {
    "outDir": "./dist/",
    "sourceMap": true,
    "noImplicitAny": true,
    "module": "esnext",
    "moduleResolution": "node",
    "target": "es2018",
    "allowJs": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "importHelpers": true,
    "strict": true,
    "types": ["jest", "node"],
    "jsx": "react",
    // esnext.collection: mobx-keystone's public types use the newer Set methods. They are
    // polyfilled in src/core/state/setup.ts for browsers that predate them.
    "lib": ["dom", "dom.iterable", "es2018", "esnext.collection"]
  },
  "include": [
    "./src/**/*"
  ]
}
